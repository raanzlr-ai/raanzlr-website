{
  "buildCommand": "cd artifacts/raanzlr && NODE_OPTIONS=--max-old-space-size=4096 npm run build",
  "outputDirectory": "artifacts/raanzlr/dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.raanzlr.com"
        }
      ],
      "destination": "https://raanzlr.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ar.*"
        }
      ],
      "destination": "/ar",
      "permanent": false
    },
    { "source": "/", "destination": "/en", "permanent": false },
    { "source": "/book-a-call", "destination": "/en/contact", "permanent": true },
    { "source": "/en/book-a-call", "destination": "/en/contact", "permanent": true },
    { "source": "/ar/book-a-call", "destination": "/ar/contact", "permanent": true },
    { "source": "/:section(services|industries|markets|case-studies|insights|about|contact|faq|privacy-policy|terms-of-service)", "destination": "/en/:section", "permanent": true },
    { "source": "/:section(services|industries|markets|case-studies|insights)/:slug([^./]+)", "destination": "/en/:section/:slug", "permanent": true },
    { "source": "/en/insights/ai-automation-gcc-2026-test", "destination": "/en/insights", "permanent": true },
