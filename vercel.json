    { "source": "/ar/insights/saudi-arabia-ai-agents-logistics-industrial-supply-20260704", "destination": "/ar/insights/saudi-arabia-vertical-ai-agents-logistics-energy-retail-20260701", "permanent": true },
    { "source": "/en/insights/arabic-ai-agents-gcc-financial-services-20260705", "destination": "/en/insights/saudi-arabia-vertical-ai-agents-logistics-energy-retail-20260701", "permanent": true },
    { "source": "/ar/insights/arabic-ai-agents-gcc-financial-services-20260705", "destination": "/ar/insights/saudi-arabia-vertical-ai-agents-logistics-energy-retail-20260701", "permanent": true },
    { "source": "/en/insights/saudi-arabia-ai-agent-sandboxes-enterprise-workflows-20260630", "destination": "/en/insights/saudi-ai-sandboxes-vision-2030-enterprise-impact-20260625", "permanent": true },
